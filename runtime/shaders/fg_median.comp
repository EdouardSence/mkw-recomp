// Frame generation (runtime/gfx/vk/device/vk_framegen.c): the 3x3 median of the motion vectors, each component on its
// own, so a lone wrong match takes its neighbours' motion. After SkyboundTotk's kMedianWgsl
// (a64-kit/gpu/render/rx_framegen.cpp, https://github.com/NotRexed/SkyboundTotk @
// a4495f95b5e5ab6562d603058dcaa3457d0c8027, MIT, Copyright (c) 2026 NotRexed).
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D dst;

float med9(float v[9]) {
    for (int i = 0; i < 5; i++)   // the 5 smallest in order: the 5th is the median
        for (int j = i + 1; j < 9; j++)
            if (v[j] < v[i]) {
                float t = v[i];
                v[i] = v[j];
                v[j] = t;
            }
    return v[4];
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, imageSize(dst)))) return;
    ivec2 m = textureSize(src, 0) - 1;
    float xs[9], ys[9];
    for (int i = 0; i < 9; i++) {
        vec2 f = texelFetch(src, clamp(g + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), m), 0).xy;
        xs[i] = f.x;
        ys[i] = f.y;
    }
    imageStore(dst, g, vec4(med9(xs), med9(ys), 0.0, 0.0));
}
